# Mainline allowlist. Temporary task scripts always live in tmp/ and are not committed.
/*
!/.gitignore
!/AGENTS.md
!/README.md
!/pyproject.toml
!/requirements.txt
!/src/
!/utils/
!/config/
!/docs/
/src/**
!/src/**/
!/src/**/*.py
/utils/**
!/utils/**/
!/utils/**/*.py
/config/**
!/config/*.json
/docs/**
!/docs/*.md
!/docs/results/
!/docs/results/sync20_20261028/
!/docs/results/sync20_20261028/*.md
!/docs/results/sync20_20261028/shared_beta.json
!/docs/results/sync20_20261028/figures/
!/docs/results/sync20_20261028/figures/*.png
!/docs/results/sync20_20261028/media/
!/docs/results/sync20_20261028/media/*.gif
!/docs/results/sync20_20261028/media/*.mp4
/tmp/
/data/
__pycache__/
*.py[cod]
*.nb[ci]
*.egg-info/
.ruff_cache/
.pytest_cache/
.venv/
build/
dist/
.env
